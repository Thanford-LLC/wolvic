<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
<item android:state_enabled="false">
    <shape android:shape="rectangle">
        <corners android:radius="5dp" />
        <solid android:color="@color/fd_surface_raised"/>
    </shape>
</item>
<item android:state_pressed="true">
    <shape android:shape="rectangle">
        <corners android:radius="5dp" />
        <solid android:color="@color/fd_accent_pressed"/>
    </shape>
</item>
<item android:state_hovered="true" android:state_pressed="false">
    <shape android:shape="rectangle">
        <corners android:radius="5dp" />
        <solid android:color="@color/fd_accent_hover"/>
    </shape>
</item>
<item android:state_hovered="false" android:state_pressed="false">
    <shape android:shape="rectangle">
        <corners android:radius="5dp" />
        <solid android:color="@color/fd_accent"/>
    </shape>
</item>
</selector>
