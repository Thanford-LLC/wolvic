<resources>
    <!-- Combos Settings panel title + honeycomb button label on the main Settings page. -->
    <string name="settings_combos">Combos</string>

    <!-- Phase 2 — mode / HUD / haptics toggles on the Combos Settings panel. -->
    <string name="combos_mode_title">Combo mode</string>
    <string name="combos_mode_4dir">4-dir</string>
    <string name="combos_mode_8dir">8-dir</string>

    <string name="combos_hud_show">Show combo HUD</string>
    <string name="combos_hud_show_sub">Head-locked dial during grip</string>

    <!-- Per Plan §T2: resolved copy is "Buzz on combo" with a one-line sub-label. -->
    <string name="combos_buzz_on_combo">Buzz on combo</string>
    <string name="combos_buzz_on_combo_sub">1 short buzz on fire, 2 on miss</string>

    <!-- S4 (2026-04-21): combos_reset_title removed — the "Reset combos" left
         label in the footer duplicated the "Reset to defaults" button. Only
         the button label survives now (options_combos.xml drops app:description). -->
    <string name="combos_reset_button">Reset to defaults</string>

    <!-- Mode radio options. "true" = 4-dir (matches existing fingerdance_combo_4dir_mode pref). -->
    <string-array name="combos_mode_options">
        <item>@string/combos_mode_4dir</item>
        <item>@string/combos_mode_8dir</item>
    </string-array>
    <string-array name="combos_mode_values">
        <item>true</item>
        <item>false</item>
    </string-array>

    <!-- Phase 3 — categorised binding list section headers. -->
    <!-- S5 (2026-04-21): Quest 3 feedback — say "combos" everywhere the user
         sees, keep code identifiers (combos_gesture_*) unchanged. -->
    <string name="combos_section_system">System combos</string>
    <string name="combos_section_navigation">Navigation</string>
    <string name="combos_section_position">Position</string>
    <string name="combos_section_window">Window</string>
    <string name="combos_section_library">Library</string>
    <string name="combos_section_special">Special</string>
    <string name="combos_section_unassigned">Unassigned</string>
    <!-- S11 mode switch -->
    <string name="combos_mode_8dir_switch">8-dir mode</string>
    <string name="combos_mode_8dir_switch_sub">Enables diagonal directions. Gives 8 more paths. Leave off for simpler combos.</string>

    <!-- Section header for advanced / power-user toggles pinned to the bottom of
         the Combos panel. Intentionally last so newbies see bindings first. -->
    <string name="combos_section_advanced">Advanced</string>

    <!-- Phase 3 — info-only System Gestures rows. -->
    <string name="combos_gesture_longpress">Long-press joystick</string>
    <string name="combos_gesture_longpress_action">Open Combos Settings</string>
    <string name="combos_gesture_click_idle">Click joystick (idle)</string>
    <string name="combos_gesture_click_idle_action">Toggle combo HUD</string>
    <string name="combos_gesture_click_midpath">Click joystick (mid-path)</string>
    <string name="combos_gesture_click_midpath_action">Cancel combo</string>

    <!-- S3: mode-escape paths ([2]×8 / [2]×4) ship in the binding table but
         are intentionally NOT documented in the System Gestures section —
         easter-egg framing per CLAUDE.md and the sealed Combos plan. The
         combos_gesture_mode_4dir_escape* / 8dir_escape* strings that once
         lived here were removed together with their UI rows. -->

    <!-- Phase 4 — chip X-delete confirm dialog. Cancel button reuses Wolvic's
         MPL-licensed R.string.cancel_button (already translated into 24 locales). -->
    <string name="combos_delete_confirm_title">Unbind combo?</string>
    <string name="combos_delete_confirm_body">This combo will no longer fire. You can re-create it later from Combos Settings.</string>
    <string name="combos_delete_confirm_positive">Unbind</string>

    <!-- Accessibility label for the X button on a bound-combo chip. -->
    <string name="combos_chip_delete_content_desc">Unbind this combo</string>

    <!-- Phase 5 — Bind Combo dialog, FROM_SETTINGS flow.
         Cancel button reuses Wolvic's MPL-licensed R.string.cancel_button. -->
    <string name="combos_bind_from_settings_title">Bind combo to %1$s</string>
    <string name="combos_bind_draw_prompt">Hold grip and draw your combo</string>
    <string name="combos_bind_button_bind">Bind</string>
    <string name="combos_bind_same_action_error">Already bound to this action — draw a different combo.</string>
    <string name="combos_bind_conflict_warning">Already bound to %1$s — binding will replace it.</string>
    <string name="combos_bind_prefix_collision_warning">Note: another combo starts with the same moves. One may trigger before the other completes.</string>

    <!-- Phase 5 cherry-pick — Reset-to-defaults confirm dialog (footer
         button label reuses the existing combos_reset_button string). -->
    <string name="combos_reset_confirm_title">Reset all combos?</string>
    <string name="combos_reset_confirm_body">This will undo every combo you changed, deleted, or created. System combos and toggles are unaffected.</string>
    <string name="combos_reset_confirm_positive">Reset all</string>

    <!-- Phase 5 — + Create button on action rows. -->
    <string name="combos_row_create_button">+ Create</string>

    <!-- Phase 7 — ActionPickerView title and FROM_CAPTURE banner strings. -->
    <string name="combos_assign_combo_title">Assign combo</string>
    <string name="combos_capture_banner_prefix">Combo drawn:</string>
    <string name="combos_capture_banner_suffix">— tap + Create on any action below to assign it.</string>

    <!-- Phase 6 — first-launch onboarding hint. Shown once per install lifetime
         above the Tray after the splash fades; dismisses automatically. The
         one-shot gate lives in ComboBindingStore (KEY_LONGPRESS_HINT_SEEN).
         Teaches the CORE gesture (grip + joystick) per
         feedback_onboarding_teaches_core_gesture.md — NOT the advanced
         long-press-for-Settings gesture. Settings discovery is a second-order
         concern solved by the Tray honeycomb and accidental long-presses. -->
    <string name="combos_longpress_onboarding_hint">Tip: Hold grip and push the joystick to start a combo</string>
</resources>
