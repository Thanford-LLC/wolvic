    <!-- Section header for advanced / power-user toggles pinned to the bottom of
         the Combos panel. Intentionally last so newbies see bindings first. -->
    <string name="combos_section_advanced">Advanced</string>

    <!-- Phase 3 — info-only System Gestures rows. -->
    <string name="combos_gesture_longpress">Long-press joystick</string>
