    <string name="combos_reset_confirm_title">Reset all combos?</string>
    <string name="combos_reset_confirm_body">This will undo every combo you changed, deleted, or created. System combos and toggles are unaffected.</string>
    <string name="combos_reset_confirm_positive">Reset all</string>

