  Phase 3 — info-only row for the System Gestures section.
  "Gesture label  →  Action it triggers". No chips, no +Create affordance.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/fd_pad_row_h"
    android:paddingEnd="@dimen/fd_pad_row_h"
    android:paddingTop="@dimen/fd_pad_row_v_system"
    android:paddingBottom="@dimen/fd_pad_row_v_system"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/system_gesture_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/settingsText"
        android:textColor="@color/fd_text_muted"
        android:textAlignment="viewStart" />

    <TextView
        android:id="@+id/system_gesture_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/fd_pad_gesture_action_start"
        style="@style/settingsText"
        android:textColor="@color/fd_text"
        android:textAlignment="viewEnd" />

</LinearLayout>
