  Block view for the Combos Settings action grid.
  Root is FrameLayout with clipChildren=false so the path_tip can float
  above the block without affecting layout height.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Main block content: disc → label → button cell -->
    <LinearLayout
        android:id="@+id/block_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#0c1140"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:focusable="true"
        android:clickable="false">

        <!-- Path visualization disc -->
        <com.thanford.glyphew.settings.ComboPathView
            android:id="@+id/path_disc"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp" />

        <!-- Action name label -->
        <TextView
            android:id="@+id/action_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/fd_text"
            android:gravity="center"
            android:textAlignment="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Hover-revealed ✕ delete or + Create button -->
        <LinearLayout
            android:id="@+id/button_cell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/fd_min_touch_target"
            android:orientation="horizontal"
            android:gravity="center" />

    </LinearLayout>

    <!-- Floating tooltip: absolute-positioned above the block, no layout impact -->
    <TextView
        android:id="@+id/path_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:translationY="-28dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textSize="18sp"
        android:textColor="@color/fd_accent"
        android:background="@drawable/combo_tip_bg"
        android:visibility="invisible" />

</FrameLayout>
